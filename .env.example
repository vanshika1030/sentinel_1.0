# ─────────────────────────────────────────────────────────────
# Sentinel — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── LLM ──────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Embeddings ───────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Qdrant Shards ────────────────────────────────────────────
# JSON list of Qdrant URLs (one per shard)
QDRANT_URLS=["http://qdrant-0:6333","http://qdrant-1:6334"]
QDRANT_COLLECTION=sentinel_docs
QDRANT_VIRTUAL_NODES=150

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_CRAWL_JOBS=crawl_jobs
REDIS_STREAM_DLQ=crawl_dlq
REDIS_CONSUMER_GROUP=sentinel_workers
REDIS_IDEMPOTENCY_TTL=86400

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel
POSTGRES_SYNC_URL=postgresql://sentinel:sentinel@postgres:5432/sentinel

# ── Ingestion ────────────────────────────────────────────────
WORKER_COUNT=2
CRAWL_INTERVAL_HOURS=6.0
MAX_RETRIES=3
RATE_LIMIT_REQUESTS=1
RATE_LIMIT_PERIOD=2.0
HTTP_TIMEOUT=30.0

# ── Retrieval / RAG ─────────────────────────────────────────
RETRIEVER_TOP_K=20
RERANKER_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Change Detection ────────────────────────────────────────
SIGNIFICANCE_THRESHOLD=0.5

# ── Circuit Breaker ─────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_FAILURE_RATE=0.5
CB_WINDOW_SECONDS=30.0
CB_RECOVERY_TIMEOUT=30.0

# ── Competitors ─────────────────────────────────────────────
COMPETITORS_FILE=competitors.yaml

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]
